	<header>
		<smile version="1.0" namespace="std, isee"/>
		<name>Tragedy of the Commons</name>
		<uuid>a36c1489-efca-4adc-9c93-ffb61aba987e</uuid>
		<vendor>isee systems, inc.</vendor>
		<product version="2.0" isee:build_number="2187" isee:saved_by_v1="true" lang="en">Stella Architect</product>
	</header>
	<sim_specs isee:sim_duration="1.5" isee:simulation_delay="0.0789474" isee:restore_on_start="false" method="Euler" time_units="Year" isee:instantaneous_flows="false" isee:loop_scores="true" isee:loop_exhaustive_allowed="1000">
		<start>1</start>
		<stop>20</stop>
		<dt reciprocal="true">2</dt>
	</sim_specs>
	<isee:prefs show_module_prefix="true" live_update_on_drag="true" show_restore_buttons="false" layer="model" interface_scale_ui="true" interface_max_page_width="10000" interface_max_page_height="10000" interface_min_page_width="0" interface_min_page_height="0" rerun_on_structure_change="false" saved_runs="5" keep="false" rifp="true"/>
	<isee:multiplayer_settings include_chat="true" allow_observers="false" advance_time_increment="1" observer_start_page="home_page" enabled="false"/>
	<isee:time_formats default_format="Builtin">
		<isee:time_format name="Builtin" type="adaptive"/>
	</isee:time_formats>
	<default_format/>
	<model_units>
		<unit name="Years">
			<eqn/>
			<alias>yr</alias>
			<alias>year</alias>
		</unit>
	</model_units>
	<model>
		<variables>
			<stock name="A Result">
				<eqn>1</eqn>
				<inflow>A_activity</inflow>
				<units>resources</units>
			</stock>
			<stock name="B Result">
				<eqn>2</eqn>
				<inflow>B_activity</inflow>
				<units>resources</units>
			</stock>
			<stock name="Resources Available">
				<eqn>50</eqn>
				<inflow>resource_replenishment</inflow>
				<outflow>A_activity</outflow>
				<outflow>B_activity</outflow>
				<units>resources</units>
			</stock>
			<flow name="A activity">
				<eqn>IF (A_FACTOR*UNITS_CONVERSION*A_Result&lt;.5*(Resources_Available-MINIMUM_RESOURCE)) THEN A_FACTOR*A_Result ELSE .5*(Resources_Available-MINIMUM_RESOURCE)/UNITS_CONVERSION</eqn>
				<non_negative/>
				<units>resources/year</units>
			</flow>
			<flow name="B activity">
				<eqn>IF (B_FACTOR*UNITS_CONVERSION*B_Result&lt;.5*(Resources_Available-MINIMUM_RESOURCE)) THEN B_FACTOR*B_Result ELSE .5*(Resources_Available-MINIMUM_RESOURCE)/UNITS_CONVERSION</eqn>
				<non_negative/>
				<units>resources/year</units>
			</flow>
			<flow name="resource replenishment">
				<eqn>REPLENISHMENT_RATE</eqn>
				<non_negative/>
				<units>resources/year</units>
			</flow>
			<aux name="MINIMUM RESOURCE">
				<eqn>0</eqn>
				<units>resources</units>
			</aux>
			<aux name="A FACTOR">
				<eqn>.3</eqn>
				<units>1/year</units>
			</aux>
			<aux name="B FACTOR">
				<eqn>.2</eqn>
				<units>1/year</units>
			</aux>
			<aux name="REPLENISHMENT RATE">
				<eqn>0</eqn>
				<units>resources/year</units>
			</aux>
			<aux name="UNITS CONVERSION">
				<eqn>DT</eqn>
				<units>Year</units>
			</aux>
		</variables>
