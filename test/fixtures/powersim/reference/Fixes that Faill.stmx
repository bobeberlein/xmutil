		<name>Fixes that Faill</name>
		<uuid>eac2bd18-4cd0-4f7d-94cd-626e1fb14cdb</uuid>
		<vendor>isee systems, inc.</vendor>
		<product version="2.0" isee:build_number="2187" isee:saved_by_v1="true" lang="en">Stella Architect</product>
	</header>
	<sim_specs isee:sim_duration="1.5" isee:simulation_delay="0.166667" isee:restore_on_start="false" method="Euler" time_units="Years" isee:instantaneous_flows="false" isee:loop_scores="true" isee:loop_exhaustive_allowed="1000">
		<start>1</start>
		<stop>10</stop>
		<dt reciprocal="true">1</dt>
	</sim_specs>
	<isee:prefs show_module_prefix="true" live_update_on_drag="true" show_restore_buttons="false" layer="model" interface_scale_ui="true" interface_max_page_width="10000" interface_max_page_height="10000" interface_min_page_width="0" interface_min_page_height="0" rerun_on_structure_change="false" saved_runs="5" keep="false" rifp="true"/>
	<isee:multiplayer_settings include_chat="true" allow_observers="false" advance_time_increment="1" observer_start_page="home_page" enabled="false"/>
	<isee:time_formats default_format="Builtin">
		<isee:time_format name="Builtin" type="adaptive"/>
	</isee:time_formats>
	<default_format/>
	<model_units>
		<unit name="Years">
			<eqn/>
			<alias>yr</alias>
			<alias>year</alias>
		</unit>
	</model_units>
	<model>
		<variables>
			<stock name="Current State">
				<eqn>0</eqn>
				<inflow>action</inflow>
				<outflow>diminish</outflow>
				<units>State</units>
			</stock>
			<stock name="Unexpected Consequences">
				<eqn>0</eqn>
				<inflow>unexpeced_consequences_flow</inflow>
				<units>State</units>
			</stock>
			<flow name="diminish">
				<eqn>Unexpected_Consequences*UNEXPECTED_CONSEQUENCES_DIMINISH_FACTOR</eqn>
				<non_negative/>
				<units>State/Years</units>
			</flow>
			<flow name="action">
				<eqn>goal_gap*ACTION_FACTOR</eqn>
				<non_negative/>
				<units>State/Years</units>
			</flow>
			<flow name="unexpeced consequences flow">
				<eqn>action*UNEXPECTED_CONSEQUENCES_FACTOR</eqn>
				<non_negative/>
				<units>State/Years</units>
			</flow>
			<aux name="DESIRED STATE">
				<eqn>1</eqn>
				<units>State</units>
			</aux>
			<aux name="goal gap">
				<eqn>DESIRED_STATE-Current_State</eqn>
				<units>State</units>
			</aux>
			<aux name="UNEXPECTED CONSEQUENCES DIMINISH FACTOR">
				<eqn>0</eqn>
				<units>1/Years</units>
			</aux>
			<aux name="ACTION FACTOR">
				<eqn>.3</eqn>
				<units>1/Years</units>
			</aux>
			<aux name="UNEXPECTED CONSEQUENCES FACTOR">
				<eqn>0</eqn>
			</aux>
		</variables>
