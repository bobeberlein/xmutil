	<header>
		<smile version="1.0" namespace="std, isee"/>
		<name>Escalation</name>
		<uuid>8303a7d1-c82b-417e-bc88-63d38ba0c026</uuid>
		<vendor>isee systems, inc.</vendor>
		<product version="2.0" isee:build_number="2187" isee:saved_by_v1="true" lang="en">Stella Architect</product>
	</header>
	<sim_specs isee:sim_duration="1.5" isee:simulation_delay="0.166667" isee:restore_on_start="false" method="Euler" time_units="Years" isee:instantaneous_flows="false" isee:loop_scores="true" isee:loop_exhaustive_allowed="1000">
		<start>1</start>
		<stop>10</stop>
		<dt reciprocal="true">1</dt>
	</sim_specs>
	<isee:prefs show_module_prefix="true" live_update_on_drag="true" show_restore_buttons="false" layer="model" interface_scale_ui="true" interface_max_page_width="10000" interface_max_page_height="10000" interface_min_page_width="0" interface_min_page_height="0" rerun_on_structure_change="false" saved_runs="5" keep="false" rifp="true"/>
	<isee:multiplayer_settings include_chat="true" allow_observers="false" advance_time_increment="1" observer_start_page="home_page" enabled="false"/>
	<isee:time_formats default_format="Builtin">
		<isee:time_format name="Builtin" type="adaptive"/>
	</isee:time_formats>
	<default_format/>
	<model_units>
		<unit name="Years">
			<eqn/>
			<alias>yr</alias>
			<alias>year</alias>
		</unit>
	</model_units>
	<model>
		<variables>
			<stock name="Ted Results">
				<eqn>.3</eqn>
				<inflow>ted_flow</inflow>
				<units>Results</units>
			</stock>
			<stock name="Anne Results">
				<eqn>.4</eqn>
				<inflow>anne_flow</inflow>
				<units>Results</units>
			</stock>
			<flow name="ted flow">
				<eqn>(IF (Anne_Results&gt;Ted_Results) THEN
  THREAT*(Anne_Results-Ted_Results)
ELSE
  0)+TED_ACT</eqn>
				<non_negative/>
				<units>Results/Years</units>
			</flow>
			<flow name="anne flow">
				<eqn>(IF (Ted_Results&gt;Anne_Results) THEN
  THREAT*(Ted_Results-Anne_Results)
ELSE
  0)+ANNE_ACT</eqn>
				<non_negative/>
				<units>Results/Years</units>
			</flow>
			<aux name="ANNE ACT">
				<eqn>.2</eqn>
				<units>Results/Years</units>
			</aux>
			<aux name="TED ACT">
				<eqn>.1</eqn>
				<units>Results/Years</units>
			</aux>
			<aux name="THREAT">
				<eqn>2.4</eqn>
				<units>1/Years</units>
			</aux>
		</variables>
