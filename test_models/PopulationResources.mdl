{UTF-8}
effect food deaths= WITH LOOKUP (
	food adequacy,
		([(0,1)-(1,10)],(0,10),(0.207951,6.13158),(0.409786,4.07895),(0.59633,2.5),(1,1) ))
	~	Dmnl
	~		|

food adequacy=
	consuming/inidcated consumption
	~	Dmnl
	~		|

inidcated consumption=
	Population * consumption per rabbit
	~	Kg/Month
	~		|

consuming=
	MIN(inidcated consumption,Resources/min consumption time)
	~	Kg/Month
	~		|

consumption per rabbit=
	1
	~	Kg/Rabbit/Month
	~		|

deaths=
	Population / average lifetime * effect food deaths
	~	Rabbit/Month
	~		|

min consumption time=
	2
	~	Month
	~		|

Resources= INTEG (
	-consuming,
		100000)
	~	Kg
	~		|

average lifetime=
	60
	~	Months
	~		|

birth rate=
	0.1
	~	1/Month
	~		|

births=
	Population * birth rate
	~	Rabbit/Month
	~		|

Population= INTEG (
	births-deaths,
		100)
	~	Rabbit
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 100
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Month [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Month [0,?]
	~	The time step for the simulation.
	|

